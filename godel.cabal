cabal-version:      3.0
name:               godel
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             TurtlePU
maintainer:         sokolov.p64@gmail.com
-- copyright:
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common stanzas
    ghc-options:        -Wall -Werror
    default-language:   Haskell2010
    default-extensions: ImportQualifiedPost

library
    import:          stanzas
    exposed-modules: Godel.Module.Discovery
    -- other-modules:
    build-depends:   base, containers, transformers
    hs-source-dirs:  src

executable godel
    import:         stanzas
    main-is:        Main.hs
    -- other-modules:
    build-depends:  base, godel
    hs-source-dirs: app

test-suite godel-test
    import:         stanzas
    -- other-modules:
    type:           exitcode-stdio-1.0
    hs-source-dirs: test
    main-is:        Main.hs
    build-depends:  base, godel
